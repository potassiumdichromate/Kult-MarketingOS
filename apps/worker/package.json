{
  "name": "@kult/worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "x:live-check": "tsx src/scripts/x-live-check.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kult/ai": "workspace:*",
    "@kult/config": "workspace:*",
    "@kult/database": "workspace:*",
    "@kult/integrations": "workspace:*",
    "@kult/shared": "workspace:*",
    "bullmq": "^6.3.1",
    "ioredis": "^5.8.2",
    "pino": "^10.3.1",
    "zod": "^4.4.3",
    "@prisma/client": "7.10.0",
    "openai": "^7.8.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "main": "./dist/main.js"
}
