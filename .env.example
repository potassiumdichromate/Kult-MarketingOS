# =============================================================================
# Kult Marketing OS - environment
#
# Copy to .env and fill in. Every variable here is read by the implementation;
# there are no unused placeholders. Variables are validated at startup, and the
# process exits with a list of problems rather than starting half-configured.
#
# Optional provider blocks are all-or-nothing: supply every variable in a block
# or none of them. Partial configuration is a startup error, never a silently
# half-enabled integration.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development                  # development | test | staging | production
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000        # must be https when APP_ENV=production
API_URL=http://localhost:4000        # must be https when APP_ENV=production
# Extra browser origins allowed by CORS, comma separated. WEB_URL is always allowed.
# CORS_ADDITIONAL_ORIGINS=https://staging.kult.games
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace

# --- Data stores -------------------------------------------------------------
DATABASE_URL=postgresql://kult:kult@localhost:5432/kult_marketing
REDIS_URL=redis://localhost:6379

# --- Authentication (Privy) --------------------------------------------------
# App ID is public and also given to the browser as NEXT_PUBLIC_PRIVY_APP_ID.
# The app secret is server-only and must never reach the browser.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: Privy verification (public) key. Set it to verify tokens offline
# with no per-request network call. Without it the SDK fetches and caches JWKS.
# PRIVY_VERIFICATION_KEY=

# --- Secret handling ---------------------------------------------------------
# 32 bytes, hex or base64. Generate with:  openssl rand -hex 32
#
# WARNING: if this key is lost, every stored OAuth token becomes permanently
# unrecoverable and all social accounts must be reconnected. Back it up in a
# secret manager, separately from database backups. See docs/RUNBOOK.md.
ENCRYPTION_KEY=

# --- AI ----------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=                   # only for an OpenAI-compatible gateway
# Model names are configuration, never hardcoded. Set these to models your
# account actually has access to; the application does not assume availability.
OPENAI_DEFAULT_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_REASONING_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Leave unset to disable AI image generation. The media generation UI is then
# disabled rather than offering a button that cannot work.
# OPENAI_IMAGE_MODEL=gpt-image-1
AI_WEB_SEARCH_ENABLED=true
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RETRIES=2

# --- Brand knowledge base ----------------------------------------------------
# Retrieval ranks in PostgreSQL with the kult_cosine_similarity function created
# by migration. No vector extension or external vector database is required.
KNOWLEDGE_VECTOR_BACKEND=inprocess
KNOWLEDGE_INPROCESS_MAX_CHUNKS=5000

# --- Object storage (S3-compatible) -----------------------------------------
# Optional. Without it, document upload and media assets are refused with an
# explicit message naming these variables.
#
# STORAGE_PUBLIC_BASE_URL is REQUIRED for Instagram publishing: Instagram builds
# a media container by fetching a publicly reachable URL and accepts no direct
# binary upload.
# STORAGE_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# STORAGE_REGION=eu-west-1
# STORAGE_BUCKET=kult-marketing-assets
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_BASE_URL=https://assets.kult.games
# STORAGE_FORCE_PATH_STYLE=false     # true for MinIO and some R2 setups

# --- Social: X ---------------------------------------------------------------
# OAuth 2.0 Authorization Code with PKCE. Register the redirect URI exactly as
# written here in the X developer portal.
# Scopes requested: tweet.read tweet.write users.read media.write offline.access
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=http://localhost:4000/api/v1/integrations/x/callback

# --- Social: Instagram (via Meta) --------------------------------------------
# Uses Business Login for Instagram. Publishing requires an Instagram
# PROFESSIONAL account (Business or Creator); a personal account cannot be
# published to through any official API.
# Scopes: instagram_business_basic instagram_business_content_publish
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:4000/api/v1/integrations/instagram/callback
META_GRAPH_VERSION=v23.0

# --- Social: LinkedIn --------------------------------------------------------
# Scopes: openid profile email w_member_social (member posting).
# Company-page posting additionally needs w_organization_social, which requires
# separate LinkedIn product access. Per-post metrics need r_member_social, which
# LinkedIn grants only to approved applications.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://localhost:4000/api/v1/integrations/linkedin/callback
# LinkedIn sunsets a versioned API roughly a year after release. Keep current.
LINKEDIN_API_VERSION=202608

# --- Research sources --------------------------------------------------------
# Each is optional. A source with no credentials is shown in the research UI as
# unavailable, with the reason, rather than silently skipped.
#
# X recent search requires a paid X API access tier.
# X_BEARER_TOKEN=
# Reddit application-only OAuth. Reddit requires a descriptive User-Agent.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=KultMarketingOS/1.0 (by /u/your-reddit-username)
# YouTube Data API v3 key.
# YOUTUBE_API_KEY=
#
# Note: Google Trends has no official public API and is therefore permanently
# reported as unavailable. There is no variable to enable it.

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=300

# --- Observability -----------------------------------------------------------
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=5
# Hard ceiling on autopilot publications per organization per day. Autopilot is
# disabled by default and must be turned on explicitly per organization.
AUTOPILOT_DAILY_PUBLISH_LIMIT=6

# =============================================================================
# Web application (apps/web)
#
# Only NEXT_PUBLIC_* values reach the browser. Never put a secret here.
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PRIVY_APP_ID=
