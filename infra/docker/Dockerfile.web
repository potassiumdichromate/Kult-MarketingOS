# syntax=docker/dockerfile:1.7
#
# Kult Marketing OS - web
#
# IMPORTANT: Next.js inlines NEXT_PUBLIC_* values into the client bundle at
# BUILD time, not at run time. Setting them only in the container environment
# has no effect on an already-built image. They are therefore build arguments,
# and changing either one requires rebuilding this image.
#
# Neither value is a secret: the Privy app ID is a publishable identifier and
# the API URL is a public endpoint. No server-side secret is ever passed here.
#
#   docker build -f infra/docker/Dockerfile.web \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.kult.games \
#     --build-arg NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id \
#     -t kult-marketing-web .

ARG NODE_VERSION=22-alpine

FROM node:${NODE_VERSION} AS base
RUN apk add --no-cache libc6-compat && corepack enable
WORKDIR /app
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/config/package.json        packages/config/
COPY packages/shared/package.json        packages/shared/
COPY packages/database/package.json      packages/database/
COPY packages/auth/package.json          packages/auth/
COPY packages/integrations/package.json  packages/integrations/
COPY packages/ai/package.json            packages/ai/
COPY apps/api/package.json               apps/api/
COPY apps/worker/package.json            apps/worker/
COPY apps/web/package.json               apps/web/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
FROM base AS build
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_PRIVY_APP_ID

# Fail early and loudly rather than shipping a bundle that points at localhost
# or cannot initialise Privy.
RUN test -n "$NEXT_PUBLIC_API_URL" || (echo "ERROR: build-arg NEXT_PUBLIC_API_URL is required" && exit 1)
RUN test -n "$NEXT_PUBLIC_PRIVY_APP_ID" || (echo "ERROR: build-arg NEXT_PUBLIC_PRIVY_APP_ID is required" && exit 1)

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_PRIVY_APP_ID=$NEXT_PUBLIC_PRIVY_APP_ID \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# The web app imports @kult/shared for its domain vocabulary, so that package's
# compiled output must exist before Next builds.
RUN pnpm --filter @kult/config build \
    && pnpm --filter @kult/shared build \
    && pnpm --filter @kult/web build

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS runner
RUN apk add --no-cache curl
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# `output: 'standalone'` produces a server bundle carrying only the modules the
# app actually imports, so no workspace node_modules is copied here.
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
# COPY fails the build outright when its source is missing, so apps/web/public
# must exist in the repository even while it holds nothing but .gitkeep. Next.js
# serves that directory verbatim at the site root; dropping this line instead
# would let a favicon added later go silently missing from the image.
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public

USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:3000/login || exit 1

# The standalone bundle preserves the workspace layout, so the server entrypoint
# lives at the app's path within it.
CMD ["node", "apps/web/server.js"]
